    "pair_definition": "Each sampled clean embedding is paired with one registered transformed embedding of the identical path and label; real and AI groups use the same transformation registry and sampling distribution.",
    "supervised_loss": "0.5 * (BCE(clean_logit, label) + BCE(transformed_logit, label))",
    "consistency_loss": "MSE(sigmoid(clean_logit), sigmoid(transformed_logit))",
    "anchor_loss": "mean((coefficient - E3_coefficient)^2) + (intercept - E3_intercept)^2 / 513",
