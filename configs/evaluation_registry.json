  "status": "retrospective_e1_e5_baseline_and_forward_e6_policy",
  "purpose": "Record how every dataset unit has already been used so a viewed test cannot later be described as a fresh E6 evaluation.",
  "plain_language_rule": "Training data is study material, validation data is practice material, a consumed test is an exam whose answers have been seen, and a locked test is a sealed future exam.",
  "policies": {
    "consumed_test_rule": "A test becomes consumed once any result from it is viewed or it influences model, data, threshold, or evaluation design. It may be reported as regression evidence but never as a fresh external claim.",
    "locked_test_rule": "A locked test must be registered and preregistered before image inspection, feature extraction, scoring, or result access. It cannot be used for training, validation, threshold selection, or model selection.",
    "role_separation_rule": "No image, prompt, source identity, near-duplicate, or provenance unit may cross development and locked-test roles.",
    "failed_test_rule": "A failed external test stays consumed. A different dataset must not be searched merely to obtain a favourable result.",
    "organiser_validation_rule": "The organiser COCO val2017 and DALL-E Advanced validation subset remains prohibited for all development and project evaluation.",
    "organiser_validation_subset_used": false
  },
  "retrospective_clarifications": [
    {
      "id": "aigibench_real_source_overlap",
      "finding": "The frozen E5 protocol described AIGIBench Open Images V7 photographs as a new authentic source, while the E4/E5 records also describe SID-Set real images as originating from Open Images V7.",
      "meaning": "The selected files were byte-disjoint, but the upstream real-source family was not independent. AIGIBench remains useful unseen-Midjourney diagnostic evidence, not evidence of generalisation to a new real-source family.",
      "historical_files_modified": false
    }
  ],
