      0.001,
      0.01,
      0.1
    ],
    "all_anchor_candidates_must_run": true,
    "batch_size": 1024,
    "maximum_epochs": 40,
    "optimizer": "AdamW",
    "learning_rate": 0.005,
    "weight_decay": 0.0001,
    "consistency_weight": 1.0,
    "early_stopping_patience": 8,
    "random_seed": 505
  },
  "validation_and_decision_selection": {
